# Convex deploy key (Production/Preview deploys only; not needed for local dev)
CONVEX_DEPLOY_KEY=

# Public origin used in checkout redirects, emails, canonicals, and the sitemap.
# Use http://localhost:3000 locally; production must be HTTPS. Localhost and
# temporary tunnel hosts are ignored by the SEO layer.
APP_URL=https://anything4boys.com

# Convex (set by `convex dev` locally; set explicitly on Vercel)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Bachs payments
BACHS_API_KEY=
BACHS_ENV=sandbox
BACHS_WEBHOOK_SECRET=
CHECKOUT_REDIRECT_URL=
CONNECT_ENABLED=false
PLATFORM_FEE_BPS=500
SETTLEMENT_HOLD_HOURS=24
MIN_PAYOUT_MINOR=100000

# Payment driver. Production must use bachs; never set ALLOW_SIMULATED in prod.
PAYMENTS_DRIVER=bachs
ALLOW_SIMULATED=

# Comma-separated allow-list. Admin access also requires a verified email.
ADMIN_EMAILS=marvellousobatale@gmail.com

# Transactional email (Convex Auth verification/reset + contact notifications)
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=

# Cloudflare Turnstile (both keys required once Turnstile is enabled)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
